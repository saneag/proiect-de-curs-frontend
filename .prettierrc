{
    "printWidth": 80,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./src/styles.css",
    "overrides": [
        {
            "files": ["*.json", "*.css", "*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
